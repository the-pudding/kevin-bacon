# Two copies of this file, one per Supabase project. Vite picks by mode:
#   .env             `npm run dev` (and every dev-server script: sheet, a11y)
#   .env.production  `npm run build`, so `make staging`; overrides .env
# Fill each in from its project's dashboard (Project Settings > API — the
# "publishable" key, not the secret key). See supabase/schema.sql for the
# tables these write to. PUBLIC_ prefix required: SvelteKit exposes these to
# client code via $env/dynamic/public. Left unset, analytics.js logs a console
# warning and skips recording instead of failing the build.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# How many readers must have finished a quiz before the credits show its
# results histograms. Unset, it defaults to 50 (see src/utils/analytics.js).
PUBLIC_MIN_QUIZ_TAKERS=

{
	"control": {
		"focus": {
			"value": "{color.gray-500}",
			"comment": "the focus ring",
			"contrast": {
				"against": "surface.page",
				"min": 3
			}
		},
		"button": {
			"primary": {
				"bg": {
					"value": "{color.white}",
